# =============================================================================
# Numi — environment configuration (EXAMPLE ONLY — never put real secrets here)
# =============================================================================

# --- General ---
NUMI_ENV=development
LOG_LEVEL=INFO

# --- Control-plane database (Gateway) ---
CONTROL_DB_URL=postgresql+asyncpg://numi:numi@localhost:5432/numi_control
# For unit tests / local dev without Postgres:
# CONTROL_DB_URL=sqlite+aiosqlite:///./numi_dev.db

# --- Redis (rate limiting, session cache) ---
REDIS_URL=redis://localhost:6379/0

# --- WSL2-native Docker only (skip this if you're on Docker Desktop) ---
# The execution container's `host.docker.internal` alias needs this to
# actually reach Windows: WSL2's own default gateway, not the Docker
# bridge's. Find it from a WSL shell (not inside a container):
#   ip route show default | awk '{print $3}'
WINDOWS_HOST_IP=

# --- Secrets manager ---
# one of: local_dev | vault | aws_secrets_manager | azure_key_vault | gcp_secret_manager
# Each real backend needs its own SDK extra installed — only the one you
# select:  pip install -e ".[secrets-vault]"   (or secrets-aws /
# secrets-azure / secrets-gcp). Store one secret per server id, holding the
# same JSON object config/dev_credentials.yaml uses; see DEPLOYMENT.md.
SECRETS_PROVIDER=local_dev
VAULT_ADDR=
VAULT_TOKEN=
AWS_REGION=
AZURE_KEY_VAULT_URL=
GCP_PROJECT_ID=

# --- Identity provider ---
# one of: mock | oidc
# `oidc` resolves a Slack/Teams account id against a real SCIM directory
# (no new package needed — httpx is already a base dependency). It also
# needs the `oidc:` section of config/identity.yaml: the SCIM
# directory_endpoint, and which directory attribute holds each channel's
# account id. See DEPLOYMENT.md.
IDENTITY_PROVIDER=mock
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Config file locations ---
POLICY_CONFIG_PATH=./config/policy.yaml
SERVERS_CONFIG_PATH=./config/servers.yaml
IDENTITY_CONFIG_PATH=./config/identity.yaml
RATE_LIMIT_CONFIG_PATH=./config/rate_limits.yaml
# "memory" (default) only counts within one process — fine for a single
# Gateway instance. Set to "redis" the moment you run more than one replica,
# or every rate limit is silently multiplied by replica count. Required to
# be "redis" once NUMI_ENV=production (validate_for_production enforces it).
RATE_LIMIT_BACKEND=memory

# --- Discovery (server/database/object metadata crawler) ---
# The Gateway reads each registered server's catalog (databases, tables,
# indexes, extensions) — never table contents. It refreshes lazily on first
# use and on the `/discover` command; set the interval below and, optionally,
# an eager crawl at Gateway startup.
DISCOVERY_REFRESH_MINUTES=60
DISCOVERY_MAX_OBJECTS_PER_DATABASE=5000
DISCOVERY_ON_STARTUP=false

# --- LLM providers (spec §34) ---
# Provide a key for any provider you want DBAs to be able to use. Each
# provider becomes selectable via the `/model` chat command the moment its
# key is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
#
# LLM_PROVIDER: "" / "auto" = auto-pick the first configured provider
#   (order: anthropic, openai, gemini, deepseek);
#   "mock" = deterministic offline planner (used when no keys are set);
#   "<name>" = force that provider AND disable per-conversation /model switching.
LLM_PROVIDER=
# Default model for the resolved provider ("" = that provider's own default).
LLM_MODEL=
# Whether DBAs may switch provider/model mid-conversation with `/model`.
ALLOW_USER_MODEL_SELECTION=true

# --- Service-to-service auth ---
SERVICE_JWT_SECRET=replace-with-a-long-random-value
SERVICE_JWT_ISSUER=numi-internal

# --- Gateway ---
GATEWAY_BASE_URL=http://localhost:8001
GATEWAY_PORT=8001

# --- Execution service ---
EXECUTION_BASE_URL=http://localhost:8002
EXECUTION_PORT=8002
EXECUTION_SERVICE_TOKEN_AUDIENCE=numi-execution
# The Execution Service always uses real database connections. Install the
# db drivers with:  pip install -e ".[db-drivers]"
# and put connection details in config/dev_credentials.yaml (SECRETS_PROVIDER=local_dev)
# or a real secrets manager.

# --- Agent service ---
AGENT_BASE_URL=http://localhost:8000
AGENT_PORT=8000

# --- Daily health digest (agent service; off by default) ---
# Once a day, sweep every registered server with the comprehensive_summary
# playbook and post ONE combined digest. The destination channel is the only
# switch: leave it empty and no scheduler or job is created at all.
# A scheduled run is always read-only — it reports and recommends, and can
# never execute a write or request an approval. See OPERATIONS.md.
DAILY_REPORT_SLACK_CHANNEL=
DAILY_REPORT_HOUR_UTC=6
# Empty = every active registered server. Comma-separated ids/aliases to narrow.
DAILY_REPORT_SERVERS=
# The real DBA account each scheduled call is authorized and audited as —
# no privilege of its own; the Gateway re-resolves it like any other request.
DAILY_REPORT_IDENTITY_CHANNEL=dev
DAILY_REPORT_IDENTITY_ACCOUNT=

# --- Alert-triggered investigation (agent + channels services; off by default) ---
# An external monitoring system (Prometheus Alertmanager, Datadog, a cloud
# provider's own alarms, ...) POSTs a threshold-breach alert to Channels'
# /webhooks/alerts; the Agent then runs one freeform, read-only investigation
# against the named server and posts the result. Same read-only guarantee as
# the daily digest above — never executes a write or requests an approval.
# See ARCHITECTURE.md's "Alert-triggered investigation".
#
# The webhook's own signing secret (channels service). Empty means the route
# refuses every request outright, never falls back to trusting an
# unauthenticated one. Send X-Numi-Alert-Timestamp / X-Numi-Alert-Signature
# — see channels/alerts/signature.py for the exact scheme.
ALERT_WEBHOOK_SECRET=
# Where a finished investigation is posted (agent service). Independent of
# DAILY_REPORT_SLACK_CHANNEL on purpose — route alerts to an incident
# channel, the digest to a different one, or share one by setting both the
# same. Empty = feature disabled.
ALERT_WEBHOOK_SLACK_CHANNEL=
# Same non-bypass guarantee as DAILY_REPORT_IDENTITY_ACCOUNT — a separate
# account from the digest's, deliberately, so the two features can be
# enabled, disabled, and audited independently.
ALERT_WEBHOOK_IDENTITY_CHANNEL=dev
ALERT_WEBHOOK_IDENTITY_ACCOUNT=
# Per-(server, metric) cooldown: a flapping metric that re-breaches its
# threshold every few minutes would otherwise re-run a full investigation
# (and re-post to the channel) on every single firing. 0 disables it.
# Shared across replicas the moment RATE_LIMIT_BACKEND=redis is set, same
# as the Gateway's own rate limiting.
ALERT_WEBHOOK_COOLDOWN_SECONDS=900

# --- Channels ---
CHANNELS_BASE_URL=http://localhost:8003
CHANNELS_PORT=8003
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# --- Feature flags (fail-closed defaults) ---
ENABLE_READONLY_SQL_TOOL=false
ENABLE_EXECUTE_SQL_TOOL=false
ENABLE_RESTORE_DATABASE_TOOL=false
ENABLE_CREATE_DATABASE_TOOL=false
ENABLE_DROP_DATABASE_TOOL=false
ENABLE_TRUNCATE_TABLE_TOOL=false
ENABLE_BULK_DELETE_TOOL=false
